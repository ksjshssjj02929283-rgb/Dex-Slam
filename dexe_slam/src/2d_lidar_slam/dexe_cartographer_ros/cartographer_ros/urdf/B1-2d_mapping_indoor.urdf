<?xml version="1.0" ?>

<robot name="B1-AMR">

	<!-- footprint -->
  <link name="base_footprint"/>
  <!-- base_link_joint -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- base_link -->
  <link name="base_link">
    <!-- 外观属性 -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.978 0.4 0.2"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
      </material>
    </visual>
    <!-- 物理碰撞属性 -->
    <collision>
      <geometry>
        <box size="0.978 0.4 0.2"/>
      </geometry>
    </collision>
    <!-- 质量和惯性 -->
    <inertial>
      <mass value="15"/>
      <inertia ixx="0.18125" ixy="0.0" ixz="0.0" iyy="0.40625" iyz="0.0" izz="0.53125"/>
    </inertial>
  </link>

  <!-- right_front_laser_joint -->
  <joint name="right_front_laser_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.382 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_forward_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- right_front_base_laser -->
  <link name="lidar_forward_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <mass value="0.1"/>
      <inertia ixx="0.000145833333333" ixy="0.0" ixz="0.0" iyy="0.000145833333333" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link>

  <!-- left_back_laser_joint -->
  <!-- <joint name="left_back_laser_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.025 0 0.785"/>
    <parent link="base_link"/>
    <child link="left_back_laser_link"/>
    <axis xyz="0 0 0"/>
  </joint> -->
  <!-- left_back_base_laser -->
  <!-- <link name="left_back_laser_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <mass value="0.1"/>
      <inertia ixx="0.000145833333333" ixy="0.0" ixz="0.0" iyy="0.000145833333333" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link> -->
  
 
  <!-- imu_link_joint -->
  <joint name="imu_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>
 
  <!-- imu_link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
 

</robot>

