<?xml version="1.0" ?>

<robot name="B1-AMR">

	<!-- footprint -->
  <link name="base_footprint"/>
  <!-- base_link_joint -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
    <axis xyz="0 0 0" />
  </joint>

  <!-- base_link -->
  <link name="base_link">
    <!-- 外观属性 -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.978 0.4 0.2"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
      </material>
    </visual>
    <!-- 物理碰撞属性 -->
    <collision>
      <geometry>
        <box size="0.978 0.4 0.2"/>
      </geometry>
    </collision>
    <!-- 质量和惯性 -->
    <inertial>
      <mass value="15"/>
      <inertia ixx="0.18125" ixy="0.0" ixz="0.0" iyy="0.40625" iyz="0.0" izz="0.53125"/>
    </inertial>
  </link>

  <link name="merged_laser_link"/>
  <joint name="merged_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="merged_laser_link"/>
    <origin xyz="0.0 0.0 0.2097" rpy="0 0 0"/>
    <axis xyz="0 0 0" />
  </joint>

  <link name="laser_forward_link">
    <inertial>
      <origin xyz="-0.00163226605178779 -3.81046922211525E-05 -0.0109858757086851" rpy="0 0 0" />
      <mass value="0.0270845630745659" />
      <inertia ixx="9.26761139629486E-06" ixy="-8.15186724546099E-09" ixz="1.11929715299346E-08" iyy="9.24891699462467E-06" iyz="7.68768412175614E-10" izz="1.54092066975936E-05" />
    </inertial>
  </link>

  <!-- <joint name="laser_forward_joint" type="fixed">
    <origin xyz="0.47503 0.27579 0.2097" rpy="-3.1416 0 0.7854" />
    <parent link="base_link" />
    <child link="laser_forward_link" />
    <axis xyz="0 0 0" />
  </joint> -->
  <!-- calibrated parameter -->
  <joint name="laser_forward_joint" type="fixed">
    <origin
      xyz="0.4653 0.2801 0.2097"
      rpy="-3.1416 0 0.7812" />
    <parent
      link="base_link" />
    <child
      link="laser_forward_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link name="laser_back_link">
    <inertial>
      <origin xyz="-0.00163226515919279 -3.81039738022448E-05 -0.0109858756959254" rpy="0 0 0" />
      <mass value="0.0270845630487793" />
      <inertia ixx="9.26761147077806E-06" ixy="-8.15116807715507E-09" ixz="1.11931999807769E-08" iyy="9.24891703100811E-06" iyz="7.6892758075562E-10" izz="1.5409206785005E-05" />
    </inertial>
  </link>

  <!-- <joint name="laser_back_joint" type="fixed">
    <origin xyz="-0.47656 -0.27579 0.2097" rpy="3.1416 0 -2.3562" />
    <parent link="base_link" />
    <child link="laser_back_link" />
    <axis xyz="0 0 0" />
  </joint> -->
  <!-- calibrated parameter -->
  <joint name="laser_back_joint" type="fixed">
    <origin
      xyz="-0.4720 -0.2713 0.2097"
      rpy="3.1416 0 -2.3502" />
    <parent
      link="base_link" />
    <child
      link="laser_back_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  
 
  <!-- imu_link_joint -->
  <joint name="imu_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.2375"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>
 
  <!-- imu_link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
 

</robot>

