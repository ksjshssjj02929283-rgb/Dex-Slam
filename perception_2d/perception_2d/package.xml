<package format="3">
  <name>perception_2d</name>
  <version>0.0.0</version>
  <description>
    perception_2d is a system that provides the target pose of struct(such as line or 
    some special structs) in the environment from the 2d-lidar sensor.
  </description>
  <maintainer email="chao.yang@geekplus.com">
    The Geekplus Authors
  </maintainer>
  <license>Apache 2.0</license>

  <url>https://github.com/googlecartographer/cartographer</url>

  <author email="chao.yang@geekplus.com">
    The Geekplus Authors
  </author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
