uint32 RESTRICTED_AREA = 1          # 禁行区
uint32 NO_DETOUR_AREA = 2           # 禁止绕障区
uint32 SPEED_LIMIT_AREA = 3         # 限速区
uint32 SLOPE_AREA = 4               # 斜坡区
uint32 CARPET_AREA = 5              # 地毯区
uint32 ELEVATOR_AREA = 6            # 电梯区
uint32 LOCALIZATION_SWITCH_AREA = 7 # 定位切换区

uint32 DENSITY = 8                  # 密集存储区域
uint32 STOP = 9                     # 系统急停区域
uint32 SHELF = 10                   # 货架存储区域
uint32 TASK = 11                    # 任务限制区域
uint32 TRAFFIC_CONTROL = 12         # 交通管制区域
uint32 ROBOT = 13                   # 机器人接任务调度的逻辑区域
uint32 BLOCK = 14                   # 地图区块
uint32 NO_STAY = 15                 # 地图禁止停留区
uint32 TRAFFIC_LIGHT = 16           # 交通管制，红绿灯
uint32 KNOCK_STOP = 17              # 碰撞急停区
uint32 SORTING_AREA = 18            # 分拣地图分拣区
uint32 SINGLE_LINE_AREA = 19        # 窄通道区域
uint32 DOUBLE_LINE_AREA = 20        # 双向行驶区域
uint32 CURRENT_LIMITING_AREA = 21   # 限流区
uint32 HIGH_DYNAMIC_AREA = 22       # 高动态环境区域
uint32 NON_DYNAMIC_AREA = 23        # 非动态环境区域
uint32 LIDAR_DEGENERATION_AREA = 24 # 长通道区域
uint32 TRACKSLIP_AREA = 25          # 易打滑区域
uint32 PURE_REFLECTOR_AREA = 26     # 纯反光柱区域
uint32 FORCE_FILTER_AREA = 27       # 点云滤波区域
uint32 ONE_WAY_AREA = 28            # 单行道区域
uint32 INTENSITY_FILTER_AREA = 29   # 激光强度滤波区域
uint32 DETOUR_AREA = 30             # 绕行区

string                  name    # 区域名称
uint32                  type    # 区域类型
geometry_msgs/Pose2D[]  polygon    # 区域点列表
float64                 max_speed_limit  # 区域最大限速
float64                 slope   # 区域坡度
uint8                   localization_mode  # 定位模式
# attrib是json格式的字符串，特定的区域设置特定的attrib。
# 例：
# 限速区设置最大速度 {"max_speed": 1.0}
# 斜坡区设置坡度 {"slope": 0.5}
# 定位切换区设置定位模式: 1代表slam定位，2代表二维码定位, {"mode": 1} 
