// for test  输出在生成多栅格地图之前
bool NormalGrid::OutNormalsToFile(const std::string & filename) const
{
  // pcl::PointCloud<pcl::>
  CHECK(!grid_normals_.empty());
  std::ofstream ofs(filename.c_str());
  LOG(INFO) << "normal size: " << grid_normals_.size();
  // LOG(INFO) << ProbabilitySize();
  for (size_t i = 0; i < grid_normals_.size(); i++) {
    if (!grid_normals_[i].is_known) {
      continue;
    }
    // LOG(INFO) << grid_normals_[i].normal.x() << " " << grid_normals_[i].normal.y();
    const Eigen::Vector2f & point = limits().GetCellCenter(FromFlatIndex(i));
    Eigen::Vector2f normal = grid_normals_[i].normal.normalized();
    ofs << point.x() << " " << point.y() << " " << 0 <<
      " " << normal.x() << " " << normal.y() << " " << 0 <<
      std::endl;
  }
  ofs.close();
  return true;
}

// 生成完多栅格尺度地图为了节省内存开销，将原先法向量存储由grid_normals_转移到finished_normals_
bool NormalGrid::FinishUpdateNormals() const
{
  if (is_finished_.test_and_set()) {
    CHECK(!grid_normals_.empty());
    for (size_t i = 0; i < grid_normals_.size(); i++) {
      if (!grid_normals_[i].is_known) {
        continue;
      }
      // LOG(INFO) << grid_normals_[i].normal.x() << " " << grid_normals_[i].normal.y();
      // const Eigen::Array2i& cell_index = FromFlatIndex(i);
      const Eigen::Vector2f & point = limits().GetCellCenter(FromFlatIndex(i));
      Eigen::Vector2f normal = grid_normals_[i].normal.normalized();
      finished_normals_.push_back(std::make_pair(point, normal));
      // finished_normals_[cell_index] = normal;
    }
    grid_normals_.clear();
    std::vector<NormalCell>().swap(grid_normals_);
  }

  return true;
}

void NormalGrid::GrowNormalLimits(const Eigen::Vector2f & point)
{
  GrowNormalLimits(point, {&grid_normals_}, {kUnknownGridNormalCell});
  // LOG(INFO) << grid_normals_.size();
  // LOG(INFO) << normal_limits_.cell_limits().num_x_cells << ","
  //          << normal_limits_.cell_limits().num_y_cells;
}

void NormalGrid::GrowNormalLimits(
  const Eigen::Vector2f & point,
  const std::vector<std::vector<NormalCell> *> & grids,
  const std::vector<NormalCell> & grids_unknown_cell_values)
{
  // CHECK(update_indices_.empty());
  // const MapLimits& limits = limits();
  // LOG(INFO) << point;
  // LOG(INFO) << normal_limits_.GetCellIndex(point);
  while (!normal_limits_.Contains(normal_limits_.GetCellIndex(point))) {
    const int x_offset = normal_limits_.cell_limits().num_x_cells / 2;
    const int y_offset = normal_limits_.cell_limits().num_y_cells / 2;
    const MapLimits new_limits(
      normal_limits_.resolution(),
      normal_limits_.max() +
      normal_limits_.resolution() * Eigen::Vector2d(y_offset, x_offset),
      CellLimits(
        2 * normal_limits_.cell_limits().num_x_cells,
        2 * normal_limits_.cell_limits().num_y_cells));
    const int stride = new_limits.cell_limits().num_x_cells;
    const int offset = x_offset + stride * y_offset;
    const int new_size = new_limits.cell_limits().num_x_cells *
      new_limits.cell_limits().num_y_cells;
    for (size_t grid_index = 0; grid_index < grids.size(); ++grid_index) {
      std::vector<NormalCell> new_cells(new_size,
        grids_unknown_cell_values[grid_index]);
      for (int i = 0; i < normal_limits_.cell_limits().num_y_cells; ++i) {
        for (int j = 0; j < normal_limits_.cell_limits().num_x_cells; ++j) {
          size_t old_index = j + i * normal_limits_.cell_limits().num_x_cells;
          if ((*grids[grid_index])[old_index].is_known) {
            new_cells[offset + j + i * stride] =
              (*grids[grid_index])[old_index];
          }
        }
      }
      *grids[grid_index] = new_cells;
    }
    normal_limits_ = new_limits;
    /*
    // limits_ = new_limits;
    if (!known_cells_box_.isEmpty()) {
      known_cells_box_.translate(Eigen::Vector2i(x_offset, y_offset));
    }
    */
  }
}

// Converts a 'cell_index' into an index into 'cells_'.
int NormalGrid::ToNormalFlatIndex(const Eigen::Array2i & cell_index) const
{
  CHECK(normal_limits_.Contains(cell_index)) << cell_index <<
    " " << normal_limits_.cell_limits().num_x_cells << " " <<
    normal_limits_.cell_limits().num_y_cells;
  return normal_limits_.cell_limits().num_x_cells * cell_index.y() + cell_index.x();
}

bool NormalGrid::MergeNormal(
  const Eigen::Array2i & cell_index,
  const Eigen::Vector2f & normal)
{
  // todo 判定栅格法向量是否可用
  // if(!normal_limits_.Contains(cell_index)) return false;
  const int flat_index = ToNormalFlatIndex(cell_index);

  float current_angle = atan2(normal.y(), normal.x());
  if (fabs(grid_normals_[flat_index].l_angle) > 4) {
    grid_normals_[flat_index].l_angle = current_angle - 0.00001;
    grid_normals_[flat_index].r_angle = current_angle + 0.00001;
  }
  if (current_angle > grid_normals_[flat_index].r_angle) {
    grid_normals_[flat_index].r_angle = current_angle;
  }
  if (current_angle < grid_normals_[flat_index].l_angle) {
    grid_normals_[flat_index].l_angle = current_angle;
  }
  // 最小夹角
  if (fabs(
      NormalizedAngleDiff(
        grid_normals_[flat_index].r_angle,
        grid_normals_[flat_index].l_angle)) < 0.174)
  {
    grid_normals_[flat_index].is_known = true;
  } else {
    grid_normals_[flat_index].is_known = false;
  }
  grid_normals_[flat_index].normal += normal;
  // LOG(INFO) << normal.x() << " " << normal.y();
  // 为了防止超过float类型的上限
  if (grid_normals_[flat_index].normal.x() > 100000 ||
    grid_normals_[flat_index].normal.y() > 100000)
  {
    grid_normals_[flat_index].normal =
      10000 * grid_normals_[flat_index].normal.normalized();
  }
  // grid_normals_[flat_index].normalize();
  return true;
}
void NormalGrid::SetNormalCell(
  const Eigen::Array2i & cell_index,
  const NormalCell & normal)
{
  // CHECK(normal.normal.norm() < 10000) << normal.normal;
  if (!normal_limits_.Contains(cell_index)) {
    // LOG(INFO)<< normal_limits_.cell_limits().num_x_cells
    //   << " " << normal_limits_.cell_limits().num_y_cells;
    // CHECK(0);
    return;
  }
  CHECK(!grid_normals_.empty());
  grid_normals_[ToNormalFlatIndex(cell_index)] = normal;
}

bool NormalGrid::IsKnownNormal(const Eigen::Array2i & cell_index) const
{
  CHECK(!grid_normals_.empty());
  return normal_limits_.Contains(cell_index) &&
         grid_normals_[ToNormalFlatIndex(cell_index)].is_known;
}

Eigen::Vector2f NormalGrid::GetNormal(const Eigen::Array2i & cell_index) const
{
  CHECK(!grid_normals_.empty());
  if (!normal_limits_.Contains(cell_index)) {
    return kUnknownGridNormal;
  }
  const int flat_index = ToNormalFlatIndex(cell_index);
  if (!grid_normals_[flat_index].is_known) {
    return kUnknownGridNormal;
  }
  return grid_normals_[flat_index].normal.normalized();
}

NormalCell NormalGrid::GetNormalCell(const Eigen::Array2i & cell_index) const
{
  CHECK(!grid_normals_.empty());
  if (!normal_limits_.Contains(cell_index)) {
    return kUnknownGridNormalCell;
  }

  const int flat_index = ToNormalFlatIndex(cell_index);
  if (!grid_normals_[flat_index].is_known) {
    // LOG(INFO) << "lll";
    // CHECK(0);
    return kUnknownGridNormalCell;
  }

  return grid_normals_[flat_index];
}

sensor::NormalPointCloud NormalGrid::GetNormals() const
{
  sensor::NormalPointCloud res;
  if (!grid_normals_.empty()) {
    for (size_t i = 0; i < grid_normals_.size(); i++) {
      sensor::NormalRangefinderPoint normal_point;
      if (!grid_normals_[i].is_known) {
        continue;
      }
      const Eigen::Vector2f & point = limits().GetCellCenter(FromFlatIndex(i));
      Eigen::Vector2f normal = grid_normals_[i].normal.normalized();
      normal_point.position = Eigen::Vector3f(point.x(), point.y(), 0);
      normal_point.normal = Eigen::Vector3f(normal.x(), normal.y(), 0);
      res.push_back(normal_point);
    }
  } else {
    for (size_t i = 0; i < finished_normals_.size(); i++) {
      sensor::NormalRangefinderPoint normal_point;
      normal_point.position = Eigen::Vector3f(
        finished_normals_[i].first.x(), finished_normals_[i].first.y(), 0);
      normal_point.normal = Eigen::Vector3f(
        finished_normals_[i].second.x(), finished_normals_[i].second.y(), 0);
      res.push_back(normal_point);
    }
  }
  return res;
}


