double NormalizedAngleDiff(double a, double b)
{
  double d1, d2;
  d1 = a - b;
  d2 = 2 * M_PI - fabs(d1);
  if (d1 > 0) {
    d2 *= -1.0;
  }
  if (fabs(d1) < fabs(d2)) {
    return d1;
  } else {
    return d2;
  }
}


std::shared_ptr<NormalGrid> InitFromImage(
  const std::vector<uint8_t> & map_data,
  const sensor::NormalPointCloud & normals,
  const std::vector<std::pair<Eigen::Array2i, Eigen::Array2i>> & weight_lines,
  const std::vector<std::pair<Eigen::Array2i, Eigen::Array2i>> & weight_areas,
  const Eigen::Vector2d & origin,
  const Eigen::Vector2i & size,
  double scale,
  mapping::ValueConversionTables & conversion_tables)
{
  int num_y_cells = size[0];
  int num_x_cells = size[1];
  Eigen::Vector2d max = Eigen::Vector2d{origin[0] + num_y_cells * scale,
    origin[1] + num_x_cells * scale};
  mapping::CellLimits cell_limits(num_x_cells, num_y_cells);
  mapping::MapLimits map_limits(scale, max, cell_limits);
  std::shared_ptr<NormalGrid> res =
    std::make_shared<NormalGrid>(map_limits, &conversion_tables);
  const double reduce_occ_weight_ratio = 1.0;

  if (size[0] == 1) {
    return res;
  }

  std::vector<Eigen::Array2i> weight_points;
  for (const auto & weight_line : weight_lines) {
    auto tmp_weight_points =
      mapping::RayToPixelMask(weight_line.first, weight_line.second, 1);
    weight_points.insert(
      weight_points.end(),
      tmp_weight_points.begin(), tmp_weight_points.end());
  }

  for (int x = 0; x < num_x_cells; x++) {
    for (int y = 0; y < num_y_cells; y++) {
      int xx = num_y_cells - 1 - y;
      // int yy = num_x_cells - 1 - x;
      // int xx = y;
      int yy = x;

      if (map_data[xx + yy * num_y_cells] == 205 ||
        map_data[xx + yy * num_y_cells] == 128 ||
        map_data[xx + yy * num_y_cells] == 127 ||
        map_data[xx + yy * num_y_cells] == 126)
      {
        res->set_correspondence_cost_cells()[
          res->ToFlatIndex(Eigen::Array2i{x, y})] = 0;
      } else {
        // 将地图被占据的初始权重设置的稍低一些，
        double correspondence = (map_data[xx + yy * num_y_cells]) / 255.0;
        if (correspondence < 0.3) {
          res->set_correspondence_cost_cells()[
            res->ToFlatIndex(Eigen::Array2i{x, y})] =
            mapping::BoundedFloatToValue(
            1 - mapping::kMaxProbability * reduce_occ_weight_ratio,
            mapping::kMinProbability, mapping::kMaxProbability);
        } else if (correspondence < 0.7) {
          const double occ = (1 - correspondence) * reduce_occ_weight_ratio;
          res->set_correspondence_cost_cells()[
            res->ToFlatIndex(Eigen::Array2i{x, y})] =
            std::max(1, static_cast<int>((1 - occ) * 0.5 * 65535));
        } else {
          res->set_correspondence_cost_cells()[
            res->ToFlatIndex(Eigen::Array2i{x, y})] = 0.5 * 65535;
        }
      }
    }
  }
  for (auto point : weight_points) {
    // LOG(INFO)<<point.x()<<" "<<point.y()<<" "
    //          <<(int)map_data[point.x() + point.y() * num_y_cells];
    res->set_correspondence_cost_cells()[
      res->ToFlatIndex(Eigen::Array2i{point.y(), num_y_cells - point.x() - 1})] = 1;
  }
  for (auto area : weight_areas) {
    auto top_left = area.first;
    auto bottom_right = area.second;
    CHECK_GE(bottom_right.x(), top_left.x());
    CHECK_GE(bottom_right.y(), top_left.y());
    for (int x = top_left.x(); x <= bottom_right.x(); x++) {
      for (int y = top_left.y(); y <= bottom_right.y(); y++) {
        //              if(map_data[ x + y * num_y_cells] < 100){
        // LOG(INFO) << x << " " << y << " " << (int)map_data[x + y * num_y_cells];
        res->set_correspondence_cost_cells()[res->ToFlatIndex(
            Eigen::Array2i{y, num_y_cells - x - 1})] = 1;
        //              }
      }
    }
  }
  const mapping::MapLimits & limits = res->limits();
  for (const auto & normal_point : normals) {
    // LOG(INFO) << "sa" << normal_point.position.head(2);
    Eigen::Array2i cell_index = limits.GetCellIndex(normal_point.position.head(2));
    // LOG(INFO) << cell_index;
    res->MergeNormal(cell_index, normal_point.normal.head(2));
  }
  // std::unique_ptr<Grid2D> grid_2d = res->ComputeCroppedGrid();
  // NormalGrid* normal_grid =
  //     static_cast<NormalGrid*>(grid_2d.release());
  // normal_grid->FinishUpdateNormals();
  return res;  // std::shared_ptr<NormalGrid>(normal_grid);
}


NormalGrid::NormalGrid(
  const MapLimits & limits,
  ValueConversionTables * conversion_tables)
: Grid2D(limits, kMinCorrespondenceCost, kMaxCorrespondenceCost,
    conversion_tables),
  conversion_tables_(conversion_tables),
  grid_normals_(limits.cell_limits().num_x_cells *
    limits.cell_limits().num_y_cells, kUnknownGridNormalCell),
  normal_limits_(limits), is_finished_(ATOMIC_FLAG_INIT)
{
}

NormalGrid::NormalGrid(
  const proto::Grid2D & proto,
  ValueConversionTables * conversion_tables)
: Grid2D(proto, conversion_tables), conversion_tables_(conversion_tables),
  grid_normals_(limits().cell_limits().num_x_cells *
    limits().cell_limits().num_y_cells, kUnknownGridNormalCell),
  normal_limits_(limits()), is_finished_(ATOMIC_FLAG_INIT)
{
  CHECK(proto.has_probability_grid_2d());
}

// Sets the probability of the cell at 'cell_index' to the given
// 'probability'. Only allowed if the cell was unknown before.
void NormalGrid::SetProbability(
  const Eigen::Array2i & cell_index,
  const float probability)
{
  uint16 & cell =
    (*mutable_correspondence_cost_cells())[ToFlatIndex(cell_index)];
  CHECK_EQ(cell, kUnknownProbabilityValue);
  cell =
    CorrespondenceCostToValue(ProbabilityToCorrespondenceCost(probability));
  mutable_known_cells_box()->extend(cell_index.matrix());
}

// Applies the 'odds' specified when calling ComputeLookupTableToApplyOdds()
// to the probability of the cell at 'cell_index' if the cell has not already
// been updated. Multiple updates of the same cell will be ignored until
// FinishUpdate() is called. Returns true if the cell was updated.
//
// If this is the first call to ApplyOdds() for the specified cell, its value
// will be set to probability corresponding to 'odds'.
bool NormalGrid::ApplyLookupTable(
  const Eigen::Array2i & cell_index,
  const std::vector<uint16> & table)
{
  DCHECK_EQ(table.size(), kUpdateMarker);
  const int flat_index = ToFlatIndex(cell_index);
  uint16 * cell = &(*mutable_correspondence_cost_cells())[flat_index];
  if (*cell >= kUpdateMarker) {
    return false;
  }
  mutable_update_indices()->push_back(flat_index);
  *cell = table[*cell];
  DCHECK_GE(*cell, kUpdateMarker);
  mutable_known_cells_box()->extend(cell_index.matrix());
  return true;
}

GridType NormalGrid::GetGridType() const
{
  return GridType::NORMAL_GRID;
}

// Returns the probability of the cell with 'cell_index'.
float NormalGrid::GetProbability(const Eigen::Array2i & cell_index) const
{
  if (!limits().Contains(cell_index)) {return kMinProbability;}
  return CorrespondenceCostToProbability(
    ValueToCorrespondenceCost(
      correspondence_cost_cells()[ToFlatIndex(cell_index)]));
}

proto::Grid2D NormalGrid::ToProto() const
{
  proto::Grid2D result;
  result = Grid2D::ToProto();
  result.mutable_probability_grid_2d();
  return result;
}


std::unique_ptr<Grid2D> NormalGrid::ComputeCroppedGrid() const
{
  CHECK_EQ(grid_normals_.size(), correspondence_cost_cells().size());
  Eigen::Array2i offset;
  CellLimits cell_limits;
  ComputeCroppedLimits(&offset, &cell_limits);
  const double resolution = limits().resolution();
  const Eigen::Vector2d max =
    limits().max() - resolution * Eigen::Vector2d(offset.y(), offset.x());
  std::unique_ptr<NormalGrid> cropped_grid =
    absl::make_unique<NormalGrid>(
    MapLimits(resolution, max, cell_limits), conversion_tables_);
  // cv::Mat mat1 = cv::Mat(cell_limits.num_x_cells, cell_limits.num_y_cells,CV_8UC1);
  for (const Eigen::Array2i & xy_index : XYIndexRangeIterator(cell_limits)) {
    if (!IsKnown(xy_index + offset)) {continue;}
    cropped_grid->SetProbability(xy_index, GetProbability(xy_index + offset));
    cropped_grid->SetNormalCell(xy_index, GetNormalCell(xy_index + offset));
    // mat1.at<uint8_t>(xy_index.x(), xy_index.y()) =
    //    uint8_t(255*GetProbability(xy_index + offset));
  }
  // static int index = 0;
  // cv::imwrite("/home/lmt/cartographer/data/submaps" + std::to_string(index++) + ".png",mat1);
  return std::unique_ptr<Grid2D>(cropped_grid.release());
}

bool NormalGrid::DrawToSubmapTexture(
  proto::SubmapQuery::Response::SubmapTexture * const texture,
  transform::Rigid3d local_pose) const
{
  Eigen::Array2i offset;
  CellLimits cell_limits;
  ComputeCroppedLimits(&offset, &cell_limits);

  std::string cells;
  for (const Eigen::Array2i & xy_index : XYIndexRangeIterator(cell_limits)) {
    if (!IsKnown(xy_index + offset)) {
      cells.push_back(0 /* unknown log odds value */);
      cells.push_back(0 /* alpha */);
      continue;
    }
    // We would like to add 'delta' but this is not possible using a value and
    // alpha. We use premultiplied alpha, so when 'delta' is positive we can
    // add it by setting 'alpha' to zero. If it is negative, we set 'value' to
    // zero, and use 'alpha' to subtract. This is only correct when the pixel
    // is currently white, so walls will look too gray. This should be hard to
    // detect visually for the user, though.
    const int delta =
      128 - ProbabilityToLogOddsInteger(GetProbability(xy_index + offset));
    const uint8 alpha = delta > 0 ? 0 : -delta;
    const uint8 value = delta > 0 ? delta : 0;
    cells.push_back(value);
    cells.push_back((value || alpha) ? alpha : 1);
  }

  common::FastGzipString(cells, texture->mutable_cells());
  texture->set_width(cell_limits.num_x_cells);
  texture->set_height(cell_limits.num_y_cells);
  const double resolution = limits().resolution();
  texture->set_resolution(resolution);
  const double max_x = limits().max().x() - resolution * offset.y();
  const double max_y = limits().max().y() - resolution * offset.x();
  *texture->mutable_slice_pose() = transform::ToProto(
    local_pose.inverse() *
    transform::Rigid3d::Translation(Eigen::Vector3d(max_x, max_y, 0.)));

  return true;
}

