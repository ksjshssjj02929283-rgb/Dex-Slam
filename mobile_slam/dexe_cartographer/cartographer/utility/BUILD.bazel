package(default_visibility = ["//visibility:public"])

cc_library(
    name = "converter",
    srcs = ["src/converter.cc"],
    hdrs = ["include/converter.hpp"],
    includes = ["include"],
    deps = [
        "@com_google_absl//absl/strings",
        "@eigen",
    ],
)

cc_library(
    name = "file_manager",
    srcs = ["src/file_manager.cc"],
    hdrs = ["include/file_manager.hpp"],
    includes = ["include"],
    deps = [
        "@boost//:filesystem",
        "@boost//:system",
        "@com_github_google_glog//:glog",
    ],
)

cc_library(
    name = "pose_save_tool",
    srcs = ["src/pose_save_tool.cc"],
    hdrs = ["include/pose_save_tool.hpp"],
    includes = ["include"],
    deps = [
        ":converter",
        ":file_manager",
        "@com_github_google_glog//:glog",
        "@eigen",
    ],
)

cc_library(
    name = "tic_toc",
    hdrs = ["include/tic_toc.h"],
    includes = ["include"],
)

cc_library(
    name = "utility",
    deps = [
        ":converter",
        ":file_manager",
        ":pose_save_tool",
        ":tic_toc",
    ],
)
