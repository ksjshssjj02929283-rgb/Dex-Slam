<launch>
  <arg name="map_folder" value="/home/ubt/data/maps" />
  <arg name="map_name" value="CWDT@20240919_104055" />
  <arg name="resolution" value="0.04" />

  <param name="/use_sim_time" value="true" />

  <node name="localization_node" pkg="cartographer_ros"
      type="localization_node" args="
          -configuration_directory $(find cartographer_ros)/configuration_files
          -configuration_basename dcm_localiztion_2d.lua
          -map_folder $(arg map_folder)
          -map_name $(arg map_name)
          -collect_metrics false"
      output="screen">
    <remap from="scan" to="scan" />
    <remap from="imu" to="imu_raw_data" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution $(arg resolution)" />

  <node name="rviz" pkg="rviz" type="rviz" required="true"
      args="-d $(find cartographer_ros)/configuration_files/demo_2d.rviz" />

  <arg name="use_rosbag" default="false" />
  <arg name="bag_filename" default="" />
  <arg name="start_time" default = "0" />

  <!-- 如果输入有use_rosbag变量，则自动播放bag包-->
  <node name="playbag" pkg="rosbag" type="play"
      args="--clock $(arg bag_filename) -s $(arg start_time)" if="$(arg use_rosbag)"/>
</launch>
